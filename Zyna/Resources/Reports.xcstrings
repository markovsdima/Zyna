      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба отправлена"
          }
        }
      }
    },
    "Reports go to the administrator of your server: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалобы получает администратор вашего сервера: %@."
          }
        }
      }
    },
    "Retry blocking": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить блокировку"
          }
        }
      }
    },
    "Retry declining invitation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить отклонение приглашения"
          }
        }
      }
    },
    "Retry leaving room": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить выход из комнаты"
          }
        }
      }
    },
    "Retry sending report": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить отправку жалобы"
          }
        }
      }
    },
    "Retry unfinished actions": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить незавершённые действия"
          }
        }
      }
    },
    "Send report": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить жалобу"
          }
        }
      }
    },
    "Sending report…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляем жалобу…"
          }
        }
      }
    },
    "Sending…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка…"
          }
        }
      }
    },
    "Sent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено"
          }
        }
      }
    },
    "Some actions couldn't be completed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все действия выполнены"
          }
        }
      }
    },
    "The administrator cannot read encrypted messages. Describe the problem in your own words. Message contents and encryption keys are not attached.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Администратор не может прочитать зашифрованные сообщения. Опишите проблему своими словами. Содержимое сообщений и ключи шифрования не прикладываются."
          }
        }
      }
    },
    "The content is unavailable or can no longer be reported.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое недоступно или на него больше нельзя пожаловаться."
          }
        }
      }
    },
    "The server %@ accepted your report.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер %@ принял вашу жалобу."
          }
        }
      }
    },
    "This action is no longer available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие больше недоступно."
          }
        }
      }
    },
    "This user is already blocked.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пользователь уже заблокирован."
          }
        }
      }
    },
    "Too many requests. Wait a moment before trying again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Подождите немного и попробуйте снова."
          }
        }
      }
    },
    "User blocked": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователь заблокирован"
          }
        }
      }
    },
    "View receipt": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть квитанцию"
          }
        }
      }
    },
    "You can close this screen. The actions will continue.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно закрыть экран — действия продолжат выполняться."
          }
        }
      }
    },
    "You can return to the receipt to check the result.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вернуться к квитанции и проверить результат."
          }
        }
      }
    },
    "You left the room": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы покинули комнату"
          }
        }
      }
    },
    "You'll stay in the room until the report is sent.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы останетесь в комнате, пока жалоба не будет отправлена."
          }
        }
      }
    },
    "Your report": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша жалоба"
          }
        }
      }
    },
    "Your report was sent. Open the receipt to review the remaining actions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба отправлена. Откройте квитанцию, чтобы проверить остальные действия."
          }
        }
      }
    },
    "Your server did not allow this action.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер не разрешил это действие."
          }
        }
      }
    },
    "Your server does not support this report.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер не поддерживает такую жалобу."
          }
        }
      }
    }
  },
  "version": "1.0"
}
