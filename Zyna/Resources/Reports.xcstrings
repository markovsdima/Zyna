{
  "sourceLanguage": "en",
  "strings": {
    "Actions are continuing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия продолжаются"
          }
        }
      }
    },
    "Actions completed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия выполнены"
          }
        }
      }
    },
    "Also report this room": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также пожаловаться на комнату"
          }
        }
      }
    },
    "Block user": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать пользователя"
          }
        }
      }
    },
    "Blocking pending": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка ожидает выполнения"
          }
        }
      }
    },
    "Blocking user…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокируем пользователя…"
          }
        }
      }
    },
    "Close the current screen, then tap again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте текущий экран и нажмите ещё раз."
          }
        }
      }
    },
    "Couldn't block user": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось заблокировать пользователя"
          }
        }
      }
    },
    "Couldn't complete this action. Check your connection and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить действие. Проверьте подключение и попробуйте снова."
          }
        }
      }
    },
    "Couldn't decline invitation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
