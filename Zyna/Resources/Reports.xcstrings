    "Pending": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидает отправки"
          }
        }
      }
    },
    "Preparing report…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготавливаем жалобу…"
          }
        }
      }
