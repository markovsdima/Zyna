    "Report conversation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожаловаться на переписку"
          }
        }
      }
    },
    "Report message": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожаловаться на сообщение"
          }
        }
      }
    },
    "Report room": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожаловаться на комнату"
          }
        }
      }
    },
